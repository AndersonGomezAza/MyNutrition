# Copy to .env.local and fill in with your Supabase project's real values
# (Supabase dashboard -> Settings -> API). Never commit .env.local.

# Project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=

# service_role key — server-only, bypasses RLS. NOT the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Any random string. Vercel sends it back as `Authorization: Bearer <value>`
# on cron requests; the scrape route checks it matches before doing work.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
